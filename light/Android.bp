soong_config_module_type {
    name: "clover_backlight_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "CLOVER_BACKLIGHT",
    bool_variables: ["USE_LCD_BACKLIGHT_INTERFACE_ONLY"],
    properties: ["cppflags"],
}

clover_backlight_cc_defaults {
    name: "clover_backlight_defaults",
    soong_config_variables: {
        USE_LCD_BACKLIGHT_INTERFACE_ONLY: {
            cppflags: ["-DUSE_LCD_BACKLIGHT_INTERFACE_ONLY=%d"],
        },
    },
}

cc_binary {
    name: "android.hardware.light-service.lineage",
    overrides: ["android.hardware.lights-service.qti"],
    defaults: [
        "hidl_defaults",
        "clover_backlight_defaults",
    ],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.lineage.rc"],
    vintf_fragments: ["android.hardware.light-service.lineage.xml"],
    cflags: select(soong_config_variable("lineagelight", "scan_for_backlight_devices"), {
        true: ["-DSCAN_FOR_BACKLIGHT_DEVICES"],
        default: [],
    }) + select(soong_config_variable("lineagelight", "snap_rgb_to_pure"), {
        true: ["-DSNAP_RGB_TO_PURE"],
        default: [],
    }),
    srcs: [
        "devices/BacklightDevice.cpp",
        "devices/LedDevice.cpp",
        "devices/RgbLedDevice.cpp",
        "models/Color.cpp",
        "models/State.cpp",
        "Devices.cpp",
        "Lights.cpp",
        "Utils.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
}
